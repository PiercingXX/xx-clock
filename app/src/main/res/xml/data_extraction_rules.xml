<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy-first backup policy: nothing leaves the device.
  Cloud backup (Android 12+) and device-to-device transfer are fully excluded;
  alarms/timers stay local-only, matching the no-INTERNET design.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
