<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- PiercingXX: monochrome + one accent (strong emphasis inverts).

         DayNight does NOT mean follow-the-system: the night qualifier is an
         internal switch ThemeSyncApplier throws from the CHOSEN theme's
         isDark, pinned before the first activity inflates. This day copy is
         what Paper/Mist select; values-night/themes.xml is what a dark pick
         selects. See CONTRACT.md, "Theme authority". -->
    <style name="Theme.XxClock" parent="Theme.Material3.DayNight.NoActionBar" tools:targetApi="31">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/primary</item>
        <item name="colorOnSecondaryContainer">@color/on_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorSurfaceContainerLowest">@color/app_background</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="colorOnSurfaceVariant">@color/on_background_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_faint</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- With system dark mode on, the platform force-darks light-themed
             views; opt out so a light pick stays light. (API 29 = minSdk, so
             no -v29 variant.) -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- The Android 12+ starting window is drawn before the first activity
             exists, so ThemeSyncApplier cannot reach it — no stored preference,
             no live window yet. Emptied statically: transparent icon, no
             branding, family-ink ground under every pick.

             Repeated verbatim in values-night/themes.xml: styles do not merge
             across configs, so a dark pick would otherwise inherit none of
             this. -->
        <item name="android:windowSplashScreenBackground">@color/pxx_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>

    <!-- Full-screen alarm alert. Deliberately NOT DayNight: the layout
         hardcodes an ink ground, so its Material chrome (snooze/stop buttons,
         outline) must be dark too — under a DayNight parent a light pick gave
         this screen ink-on-ink buttons. Constant by design. -->
    <style name="Theme.XxClock.AlarmAlert" parent="Theme.Material3.Dark.NoActionBar" tools:targetApi="31">
        <item name="colorPrimary">@color/pxx_signal</item>
        <item name="colorOnPrimary">@color/pxx_ink</item>
        <item name="colorPrimaryContainer">@color/pxx_signal</item>
        <item name="colorOnPrimaryContainer">@color/pxx_ink</item>
        <item name="colorSecondaryContainer">@color/pxx_signal</item>
        <item name="colorOnSecondaryContainer">@color/pxx_ink</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/background_dark</item>
        <item name="colorSurfaceContainerLowest">@color/background_dark</item>
        <item name="colorSurfaceContainerLow">@color/pxx_ink_raised</item>
        <item name="colorSurfaceContainer">@color/surface_dark</item>
        <item name="colorSurfaceContainerHigh">@color/surface_dark</item>
        <item name="colorSurfaceContainerHighest">@color/pxx_slate</item>
        <item name="colorOnSurface">@color/pxx_white_90</item>
        <item name="colorOnSurfaceVariant">@color/pxx_white_50</item>
        <item name="colorOutline">@color/pxx_white_25</item>
        <item name="colorOutlineVariant">@color/pxx_white_10</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>

        <!-- Same starting-window emptying as Theme.XxClock. Repeated because
             the explicit Material3.Dark parent means the base style's
             suppression does not inherit through the dotted name. -->
        <item name="android:windowSplashScreenBackground">@color/pxx_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
</resources>
