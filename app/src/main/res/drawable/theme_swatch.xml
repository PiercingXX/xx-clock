<?xml version="1.0" encoding="utf-8"?>
<!-- Round ground swatch for the theme preset rows. The solid color is a
     placeholder: SetupActivity mutates it to each preset's real background.
     The faint stroke keeps near-black swatches visible on the dark card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/pxx_graphite" />
    <stroke
        android:width="1dp"
        android:color="@color/pxx_white_25" />
</shape>
